<h1>Produtos da Categoria: <%= categoria.nome %></h1>

<a href="/produtos">Voltar para todos os produtos</a>
<br><br>

<% if (produtos.length === 0) { %>
  <p>Nenhum produto cadastrado nesta categoria.</p>
<% } else { %>
  <table border="1">
    <tr>
      <th>Nome</th>
      <th>Preço</th>
      <th>Quantidade</th>
      <th>Ações</th>
    </tr>

    <% produtos.forEach(p => { %>
      <tr>
        <td><%= p.nome %></td>
        <td><%= p.preco %></td>
        <td><%= p.quantidade %></td>
        <td>
          <a href="/produtos/<%= p.id %>/editar">Editar</a>
        </td>
      </tr>
    <% }) %>
  </table>
<% } %>